# Unreal build output, all regenerated by Scripts/build.sh
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
.vs/
.vscode/
*.VC.db
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# Packaged builds
dist/

# Higgsfield source media: large, and Scripts/fetch_assets.sh downloads it
HiggsfieldAssets/*.png
HiggsfieldAssets/*.glb
HiggsfieldAssets/*.jpg
HiggsfieldAssets/*.mp4
*.part

# Imported Unreal assets, rebuilt by Scripts/import_assets.sh
Content/Higgsfield/*.uasset
Content/Higgsfield/*.umap
Content/Higgsfield/BoatImport/
Content/Models/

# Editor and OS leftovers
*~
.DS_Store
__pycache__/
*.pyc

# Both projects regenerate Unreal assets and share plugin build outputs.
*.uasset
*.umap
games/*/HiggsfieldAssets/*.png
games/*/HiggsfieldAssets/*.glb
games/*/HiggsfieldAssets/*.jpg
games/*/HiggsfieldAssets/*.mp4
